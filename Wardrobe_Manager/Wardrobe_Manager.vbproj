<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x86;x64</Platforms>
    <RootNamespace>Wardrobe_Manager</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Configurations>Debug;Release;Publish</Configurations>
    <ApplicationIcon>Tif-Image.ICO</ApplicationIcon>
  </PropertyGroup>
	
	<PropertyGroup Condition="'$(Platform)'=='x86'">
		<PlatformTarget>x86</PlatformTarget>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishSelfContained>false</PublishSelfContained>
		<PublishAot>false</PublishAot>
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>

	<!-- Configuración para 64-bits (x64) -->
	<PropertyGroup Condition="'$(Platform)'=='x64'">
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>false</PublishSingleFile>
		<PublishSelfContained>false</PublishSelfContained>
		<PublishAot>false</PublishAot>
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
	  <DefineTrace>False</DefineTrace>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
	  <DefineTrace>False</DefineTrace>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Shaders\**" />
	  <EmbeddedResource Remove="Shaders\**" />
	  <None Remove="Shaders\**" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="backup_unlinked_files_2026-04-05.zip" />
	  <None Remove="SRC.zip" />
	  <None Remove="src2.zip" />
	</ItemGroup>
	<ItemGroup>
	  <Content Include="Tif-Image.ICO" />
	</ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants),WARDROBE_MANAGER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="FO4_Base_Library" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <CustomToolNamespace>My</CustomToolNamespace>
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

  <!-- Los iconos volvieron a vivir DENTRO de los .resx, que es el camino nativo del disenador:
       el ImageList se ve en el lienzo y el selector de ImageKey muestra las miniaturas.

       Estuvieron un tiempo como PNG sueltos + FormImageLists.vb porque el build moria con MSB3821
       (GenerateResource marca como peligroso cualquier resx con un nodo mimetype, si ademas la zona
       de seguridad del archivo es >= Internet; el arbol bajo el sync root de OneDrive daba zona 4).
       ⚠️ REMEDIDO 2026-08-17: la zona del arbol volvio a 0 y MSB3821 ya no salta — control positivo
       con Ba2_Bsa_Manager, que conserva su nodo mimetype y compila. La zona es del ENTORNO y cambia
       sola, asi que si el error vuelve, medirla antes de rediseniar nada:
           [System.Security.Policy.Zone]::CreateFromUrl("file:///C:/.../x.resx").SecurityZone

       El MSB3825 se apaga a proposito. Dice que el recurso "se deserializara a traves de
       BinaryFormatter, que se quito de .NET 9", y es FALSO: Bitmap e ImageListStreamer estan en la
       lista blanca de tipos que WinForms lee sin BinaryFormatter. Medido con el blob real del
       disenador en .NET 8.0.30, 9.0.19 y 10.0.9: carga identico en los tres. Microsoft ya esta
       sacando el warning para .NET 9+. Ver la doc de migracion de BinaryFormatter para WinForms. -->
  <PropertyGroup>
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FO4_Base_Library\FO4_Base_Library.vbproj" />
  </ItemGroup>

  <!-- ⛔ LINKEADO, NO REFERENCIADO. CrashReport se compila DENTRO de este exe a proposito: tiene que poder
       reportar que FO4_Base_Library.dll no cargo, y desde adentro de esa lib se caeria con ella. Misma
       fuente que usa NPC_Manager. Ver ..\..\FO4_Base_Library\Shared\CrashReport.vb. -->
  <ItemGroup>
    <Compile Include="..\..\FO4_Base_Library\Shared\CrashReport.vb" Link="CrashReport.vb" />
  </ItemGroup>

  <!-- Fija la plataforma del wrapper NATIVO. Va en LOS SEIS proyectos, no solo en los dos que lo
       referencian de verdad: el SDK inyecta el ProjectReference transitivo sin la metadata. Ver el .targets. -->
  <Import Project="..\..\..\DirectXTextWrapper\DirectXTexWrapper.targets" />
  <!-- Avisa si un formulario quedo con COPIA PROPIA de los iconos compartidos. Solo lee; no
       modifica nada. Warning en Debug, error en Release. Ver el comentario del .targets. -->
  <Import Project="..\..\FO4_Base_Library\IconosCompartidos.targets" />
  <!-- La configuracion Publish: es Release con carpeta propia. Sin esto compilaria SIN
       OPTIMIZAR, en verde. Ver el comentario del .targets. -->
  <Import Project="..\..\FO4_Base_Library\ConfiguracionPublish.targets" />
</Project>